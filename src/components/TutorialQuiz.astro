---
import { withBase } from 'astro-theme-university/url';
import type { TutorialQuiz } from '../lib/tutorial-quiz';

interface Props { quiz: TutorialQuiz; answersUrl: string; }
const { quiz, answersUrl } = Astro.props;
const questionId = (id: string) => `${quiz.id}-${id}`;
---

<section id={`${quiz.id}-quiz`} class="tutorial-quiz" aria-labelledby={`${quiz.id}-title`} data-tutorial-quiz data-answers-url={withBase(answersUrl)} data-state="attempt">
  <header class="quiz-header">
    <p class="quiz-kicker">Interactive quiz · {quiz.questions.length} cases · about 8 minutes + 2 to review</p>
    <h2 id={`${quiz.id}-title`}>{quiz.title}</h2>
    <p>{quiz.intro}</p>
    <p class="quiz-instructions">Make a decision in every case, then select <strong>Reveal answers</strong>. You can change any response before submitting. Scores and explanations stay hidden until the whole quiz is answered.</p>
    <p class="quiz-note">{quiz.context} Practice only: no course marks. Responses stay on this page; reloading starts a fresh attempt.</p>
  </header>

  <p class="quiz-fallback" data-quiz-fallback>The cases are readable without JavaScript. Enable JavaScript to navigate, submit your responses and unlock the explanations.</p>

  <form data-quiz-form novalidate>
    <div class="quiz-progress" data-quiz-controls hidden>
      <p data-quiz-status role="status" aria-live="polite" aria-atomic="true">0 of {quiz.questions.length} answered.</p>
      <progress data-quiz-progress value="0" max={quiz.questions.length} aria-label="Cases answered"></progress>
      <nav aria-label="Quiz cases">
        <ol class="quiz-steps">
          {quiz.questions.map((question, index) => <li>
            <button type="button" data-quiz-step={index} aria-label={`Case ${index + 1}: ${question.title}, unanswered`}>
              <span class="quiz-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span data-step-status>Unanswered</span>
            </button>
          </li>)}
        </ol>
      </nav>
    </div>

    <div class="quiz-error-summary" data-quiz-error hidden tabindex="-1" role="alert" aria-labelledby={`${quiz.id}-error-title`}>
      <h3 id={`${quiz.id}-error-title`}>A few cases still need a response</h3>
      <ul data-error-list></ul>
    </div>

    {quiz.questions.map((question, index) => <fieldset class="quiz-question" id={questionId(question.id)} data-quiz-question={question.id}>
      <legend tabindex="-1">
        <span class="quiz-case-number">Case {String(index + 1).padStart(2, '0')} / {String(quiz.questions.length).padStart(2, '0')}</span>
        <span class="quiz-case-title">{question.title}</span>
      </legend>
      <p class="quiz-skill">{question.skill}</p>
      <p class="quiz-scenario">{question.scenario}</p>
      {question.illustration && <figure class="quiz-illustration">
        <img src={withBase(question.illustration.src)} alt={question.illustration.alt} width={question.illustration.width} height={question.illustration.height} loading="lazy" />
        <figcaption>{question.illustration.caption}</figcaption>
      </figure>}
      {question.evidence && <div class="quiz-evidence">
        <table>
          <caption>{question.evidence.caption}</caption>
          <thead><tr>{question.evidence.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
          <tbody>{question.evidence.rows.map(row => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
        </table>
      </div>}
      {question.tool && <p class="quiz-tool"><strong>Model supplied</strong><br />{question.tool}</p>}
      <p id={`${questionId(question.id)}-prompt`} class="quiz-prompt">{question.prompt}</p>
      {question.type === 'choice' ? <div class="quiz-options">
        {question.options.map((option, optionIndex) => <label class="quiz-option">
          <input type="radio" name={question.id} value={option.id} required aria-describedby={`${questionId(question.id)}-prompt ${questionId(question.id)}-error`} />
          <span class="quiz-option-letter" aria-hidden="true">{String.fromCharCode(65 + optionIndex)}</span>
          <span>{option.text}</span>
        </label>)}
      </div> : <div class="quiz-number">
        <label for={`${questionId(question.id)}-input`}>{question.inputLabel}</label>
        <input id={`${questionId(question.id)}-input`} name={question.id} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" required maxlength="40" aria-describedby={`${questionId(question.id)}-prompt ${questionId(question.id)}-format ${questionId(question.id)}-error`} />
        <p id={`${questionId(question.id)}-format`} class="quiz-note">Enter one number. A calculator and your lecture notes are welcome.</p>
      </div>}
      <p id={`${questionId(question.id)}-error`} class="quiz-field-error" data-question-error hidden></p>
    </fieldset>)}

    <div class="quiz-navigation" data-quiz-controls hidden>
      <button class="quiz-button quiz-secondary" type="button" data-quiz-previous>Previous case</button>
      <button class="quiz-button quiz-secondary" type="button" data-quiz-next>Next case →</button>
      <button class="quiz-button quiz-secondary" type="button" data-quiz-unanswered hidden>Go to an unanswered case</button>
    </div>
    <div class="quiz-submit-row">
      <button class="quiz-button" type="submit" data-quiz-submit disabled aria-describedby={`${quiz.id}-unlock`}>Reveal answers</button>
      <p class="quiz-note" id={`${quiz.id}-unlock`} data-quiz-unlock>Answer all {quiz.questions.length} cases to unlock your score and the worked explanations.</p>
    </div>
    <p class="quiz-field-error" data-quiz-load-error role="alert" hidden></p>
  </form>

  <section class="quiz-results" data-quiz-results hidden aria-labelledby={`${quiz.id}-results-title`} data-pagefind-ignore>
    <p class="quiz-kicker">Audit complete · all answers unlocked</p>
    <h3 id={`${quiz.id}-results-title`} tabindex="-1" data-quiz-result-title></h3>
    <p data-quiz-result-message></p>
    <div class="quiz-feedback-list" data-quiz-feedback></div>
    <p>Carry one useful correction into your tutorial artefact. A score checks these examples; your evidence and assumptions still need review.</p>
    <button class="quiz-button quiz-secondary" type="button" data-quiz-retry>Try again</button>
  </section>
  <script is:inline type="application/json" data-quiz-definition set:html={JSON.stringify(quiz).replace(/</g, '\u003c')} />
</section>

<script>
  import { initTutorialQuizzes } from '../scripts/tutorial-quiz';
  initTutorialQuizzes();
</script>

<style>
  .tutorial-quiz { margin-block: 3rem; border: 1px solid var(--course-line); border-radius: 16px; background: var(--course-surface-raised); scroll-margin-top: 1rem; }
  .quiz-header { padding: clamp(1.1rem, 4vw, 2rem); background: var(--course-pink); border-radius: 15px 15px 0 0; border-bottom: 1px solid var(--course-line); }
  .quiz-header h2 { margin: .7rem 0 1rem; font-size: clamp(1.75rem, 4vw, 2.3rem); letter-spacing: -.035em; }
  .quiz-header p { margin: 0 0 1rem; }
  .quiz-header p:last-child { margin-bottom: 0; }
  .quiz-kicker { font-size: .8rem; line-height: 1.6; font-weight: 650; color: var(--course-pink-ink); }
  .quiz-instructions { max-width: 62ch; }
  .tutorial-quiz .quiz-note { font-size: .9rem; line-height: 1.6; color: var(--course-muted); }
  .quiz-header .quiz-note { color: var(--course-ink); }
  .quiz-fallback, .quiz-results, form { padding: clamp(1rem, 3vw, 2rem); }
  .quiz-progress { margin-bottom: 2rem; }
  .quiz-progress p { margin: 0 0 .5rem; font-size: 1rem; font-weight: 600; }
  progress { display: block; width: 100%; height: .55rem; border: 0; border-radius: 10px; overflow: hidden; background: var(--course-blue); color: var(--course-blue-ink); accent-color: var(--course-blue-ink); }
  progress::-webkit-progress-bar { background: var(--course-blue); }
  progress::-webkit-progress-value { background: var(--course-blue-ink); }
  progress::-moz-progress-bar { background: var(--course-blue-ink); }
  .quiz-steps { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .5rem; list-style: none; padding: 0; margin: 1rem 0 0; }
  .quiz-steps li { margin: 0; padding: 0; }
  .quiz-steps button { display: grid; justify-items: center; gap: .15rem; width: 100%; min-height: 60px; padding: .45rem .1rem; border: 1px solid var(--course-muted); border-radius: 8px; background: var(--course-surface-raised); color: var(--course-ink); font: inherit; font-size: .7rem; }
  .quiz-steps button[data-answered="true"] { background: var(--course-blue); }
  .quiz-steps button[aria-current="step"] { outline: 2px solid var(--course-blue-ink); outline-offset: 1px; }
  .quiz-step-number { font-size: 1.15rem; font-weight: 650; }
  .quiz-question { min-inline-size: 0; margin: 0; padding: 0; border: 0; scroll-margin-block: 1.5rem; }
  .quiz-question + .quiz-question { margin-top: 2rem; }
  .tutorial-quiz[data-enhanced] .quiz-question { margin-top: 0; }
  legend { width: 100%; padding: 0; }
  legend:focus-visible, .quiz-error-summary:focus, [data-quiz-result-title]:focus { outline: 3px solid var(--course-blue-ink); outline-offset: 5px; border-radius: 2px; }
  .quiz-case-number { display: block; font-size: .85rem; color: var(--course-blue-ink); font-weight: 600; margin-bottom: .35rem; }
  .quiz-case-title { display: block; font-size: 1.55rem; font-weight: 650; line-height: 1.3; letter-spacing: -.02em; }
  .quiz-skill { margin: .5rem 0 1.5rem; font-size: .9rem; color: var(--course-muted); }
  .quiz-scenario { margin: 0 0 1.2rem; }
  .quiz-illustration { margin: 1.5rem 0; }
  .quiz-illustration img { display: block; width: 100%; height: auto; border: 1px solid var(--course-line); border-radius: 8px; }
  .quiz-illustration figcaption { margin-top: .65rem; color: var(--course-muted); font-size: .9rem; line-height: 1.6; }
  .quiz-evidence { margin: 1.5rem 0; }
  .quiz-evidence table { width: 100%; margin: 0; font-size: 1rem; line-height: 1.5; border-collapse: collapse; }
  .quiz-evidence caption { text-align: left; color: var(--course-muted); font-size: .85rem; padding-bottom: .65rem; }
  .quiz-evidence :is(th, td) { padding: .6rem .5rem; text-align: left; border-bottom: 1px solid var(--course-line); }
  .quiz-evidence thead th { background: var(--course-blue); color: var(--course-ink); }
  .quiz-evidence tbody th { font-weight: 650; }
  .quiz-evidence tr { background: transparent; }
  .quiz-tool { padding: 1rem; background: var(--course-blue); border-radius: 8px; font-size: 1rem; overflow-wrap: anywhere; }
  .quiz-prompt { font-weight: 650; margin: 1.5rem 0 1rem; }
  .quiz-options { display: grid; gap: .75rem; }
  .quiz-option { display: grid; grid-template-columns: 1.5rem 1.5rem 1fr; align-items: start; gap: .5rem; padding: 1rem; border: 2px solid var(--course-muted); border-radius: 10px; min-height: 52px; cursor: pointer; line-height: 1.55; transition: background-color 120ms, border-color 120ms; }
  .quiz-option:hover { background: var(--course-surface); border-color: var(--course-blue-ink); }
  .quiz-option:has(input:checked) { background: var(--course-blue); border-color: var(--course-blue-ink); }
  .quiz-option:has(input:focus-visible) { outline: 3px solid var(--course-blue-ink); outline-offset: 3px; }
  .quiz-option input { width: 1.5rem; height: 1.5rem; margin: .1rem 0 0; accent-color: var(--course-blue-ink); }
  .quiz-option-letter { font-weight: 650; color: var(--course-blue-ink); }
  .quiz-number label { display: block; margin-bottom: .5rem; font-weight: 600; }
  .quiz-number input { width: min(100%, 16rem); min-height: 52px; padding: .7rem 1rem; border: 2px solid var(--course-muted); border-radius: 8px; background: var(--course-paper); color: var(--course-ink); font: inherit; }
  .quiz-number input[aria-invalid="true"] { border-color: var(--course-pink-ink); }
  .quiz-number .quiz-note { margin: .65rem 0 0; }
  .quiz-navigation { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .quiz-submit-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; padding-top: 1.5rem; margin-top: 1.5rem; border-top: 1px solid var(--course-line); }
  .quiz-submit-row p { flex: 1 1 15rem; margin: 0; }
  .quiz-button { min-height: 48px; padding: .75rem 1.1rem; border: 2px solid var(--course-blue-ink); border-radius: 8px; background: var(--course-blue-ink); color: white; font: inherit; font-size: 1rem; font-weight: 600; line-height: 1.4; }
  .quiz-button:hover:not(:disabled) { background: var(--course-ink); border-color: var(--course-ink); color: white; }
  .quiz-secondary { color: var(--course-blue-ink); background: var(--course-surface-raised); }
  .quiz-button:disabled { background: var(--course-surface); color: var(--course-muted); border-color: var(--course-muted); cursor: not-allowed; opacity: 1; }
  .quiz-field-error, .quiz-error-summary { color: var(--course-pink-ink); font-weight: 600; }
  .quiz-error-summary { border: 2px solid var(--course-pink-ink); border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; }
  .quiz-error-summary h3 { margin: 0; font-size: 1.15rem; }
  .quiz-error-summary a { display: inline-block; padding-block: .2rem; }
  .quiz-results > h3 { font-size: 1.8rem; margin: .5rem 0; }
  .quiz-results .quiz-kicker { margin-top: 0; }
  .quiz-feedback-list { display: grid; gap: 1rem; margin: 2rem 0; }
  .quiz-feedback-list :global(article) { border: 1px solid var(--course-line); border-left: 4px solid var(--course-blue-ink); border-radius: 8px; padding: 1.25rem; }
  .quiz-feedback-list :global(article[data-correct="false"]) { border-left-color: var(--course-pink-ink); }
  .quiz-feedback-list :global(h4) { font-size: 1.2rem; margin: 0 0 1rem; }
  .quiz-feedback-list :global(p) { margin: .6rem 0; }
  .quiz-feedback-list :global(.quiz-verdict) { color: var(--course-blue-ink); font-size: .9rem; font-weight: 650; }
  .quiz-feedback-list :global(article[data-correct="false"] .quiz-verdict) { color: var(--course-pink-ink); }
  @media (max-width: 480px) {
    .quiz-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .quiz-steps button { font-size: .8rem; }
    .quiz-option { padding: .8rem .65rem; gap: .35rem; grid-template-columns: 1.5rem 1.2rem 1fr; }
    .quiz-evidence :is(th, td) { padding: .5rem .25rem; }
    .quiz-navigation { align-items: stretch; }
    .quiz-navigation .quiz-button { flex: 1 1 8rem; }
    .quiz-submit-row .quiz-button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .quiz-option { transition: none; } }
</style>
