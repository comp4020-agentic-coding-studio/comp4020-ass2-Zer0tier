<script>
  function setupDeckTools() {
    if (new URLSearchParams(location.search).has('print-pdf')) return;
    const reveal = document.querySelector<HTMLElement>('.reveal');
    const slides = [...document.querySelectorAll<HTMLElement>('.reveal .slides > section')];
    const count = slides.length;
    if (!reveal || !count || reveal.dataset.deckNavigationReady) return;
    reveal.dataset.deckNavigationReady = 'true';
    const current = () => {
      const index = slides.findIndex(slide => slide.classList.contains('present'));
      return index >= 0 ? index + 1 : 1;
    };
    const turnPage = (direction: number) => {
      const page = Math.min(count, Math.max(1, current() + direction));
      if (page === current()) return;
      const hash = `#/${page}`;
      // Reveal defers URL updates after arrow/touch navigation. The desired
      // hash may already be in the URL while a different slide is visible.
      if (location.hash === hash) window.dispatchEvent(new HashChangeEvent('hashchange'));
      else location.hash = hash;
    };

    const canNavigate = () => reveal.classList.contains('ready') &&
      !reveal.matches('.overview, .paused') &&
      !document.querySelector('.r-overlay, .astromotion-whiteboard:not([hidden]), dialog[open]');
    const isEditing = (target: EventTarget | null) => target instanceof Element &&
      Boolean(target.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"]), [role="textbox"]'));

    // Capture at the window so Esc returns to the lecture before Reveal or
    // one of its overlays can use it to toggle another presentation mode.
    window.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        event.preventDefault();
        event.stopImmediatePropagation();
        if (!event.repeat) location.assign(`${import.meta.env.BASE_URL}lectures/week-01/`);
        return;
      }
      if (event.defaultPrevented || event.isComposing || event.altKey || event.ctrlKey || event.metaKey ||
          isEditing(event.target) || !canNavigate()) return;
      const key = event.key.toLowerCase();
      if (key !== 'a' && key !== 'd') return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if (!event.repeat) turnPage(key === 'a' ? -1 : 1);
    }, true);

    // Trackpads emit many small events, including momentum after release.
    // Turn once per gesture, then wait for a quiet gap before accepting another.
    let lastWheelAt = -Infinity;
    let wheelDelta = 0;
    let wheelUsed = false;
    document.addEventListener('wheel', event => {
      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey ||
          isEditing(event.target) || !canNavigate() || Math.abs(event.deltaX) > Math.abs(event.deltaY) ||
          event.deltaY === 0) return;
      const direction = Math.sign(event.deltaY);
      // Scroll an overflowing slide or embedded panel before leaving the page.
      for (let target = event.target instanceof Element ? event.target : null;
           target && target !== document.body; target = target.parentElement) {
        if (target instanceof HTMLElement && /auto|scroll/.test(getComputedStyle(target).overflowY) &&
            target.scrollHeight > target.clientHeight + 1 &&
            (direction < 0 ? target.scrollTop > 1 : target.scrollTop + target.clientHeight < target.scrollHeight - 1)) {
          lastWheelAt = performance.now();
          wheelUsed = true;
          return;
        }
      }
      event.preventDefault();
      const now = performance.now();
      if (now - lastWheelAt > 220) {
        wheelDelta = 0;
        wheelUsed = false;
      }
      lastWheelAt = now;
      if (wheelUsed) return;
      const unit = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 :
        event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? reveal.clientHeight : 1;
      wheelDelta += event.deltaY * unit;
      if (Math.abs(wheelDelta) >= 40) {
        wheelUsed = true;
        turnPage(Math.sign(wheelDelta));
      }
    }, { passive: false });

  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupDeckTools, {once:true});
  else setupDeckTools();
</script>
