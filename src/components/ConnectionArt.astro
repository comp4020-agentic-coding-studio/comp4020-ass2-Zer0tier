---
/* Course-native vector diagram: inputs, model and release are inspectable. */
---
<svg class="hero-art" viewBox="0 0 520 510" role="img" aria-labelledby="connection-art-title">
  <title id="connection-art-title">A fictional profile pipeline: measure exposures, compare a model, and ship a release with its assumptions.</title>
  <defs>
    <pattern id="paper-grid" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0V26" fill="none" stroke="var(--course-line)" stroke-width=".6"/></pattern>
  </defs>
  <rect x="12" y="10" width="496" height="486" rx="36" fill="var(--course-surface)"/>
  <rect x="12" y="10" width="496" height="486" rx="36" fill="url(#paper-grid)"/>
  <g font-family="system-ui,sans-serif" fill="#272c38">
    <text x="43" y="48" font-size="12" letter-spacing="2">NULL ISLAND / EXPERIMENT 003</text>
    <rect x="42" y="76" width="330" height="110" rx="12" fill="#f9dbe7" stroke="#903252"/>
    <text x="64" y="105" font-size="12" fill="#903252" letter-spacing="2">01 / MEASURE</text>
    <text x="64" y="141" font-size="25" font-weight="600">A: 120 / 1,000</text>
    <text x="64" y="166" font-size="16">Observed positives / exposures</text>
    <path d="M372 130H454V226H407" stroke="#28538a" stroke-width="2" stroke-dasharray="5 6" fill="none"/>
    <rect x="104" y="211" width="363" height="118" rx="12" fill="#dfeaf9" stroke="#28538a"/>
    <text x="126" y="241" font-size="12" fill="#28538a" letter-spacing="2">02 / MODEL</text>
    <text x="126" y="278" font-size="25" font-weight="600">B: 140 / 1,000</text>
    <text x="126" y="306" font-size="16">+2 percentage points. z ≈ 1.33.</text>
    <path d="M104 270H66V370H107" stroke="#903252" stroke-width="2" stroke-dasharray="5 6" fill="none"/>
    <rect x="42" y="354" width="373" height="100" rx="12" fill="var(--course-paper)" stroke="#585d68"/>
    <text x="64" y="383" font-size="12" fill="#585d68" letter-spacing="2">03 / SHIP?</text>
    <text x="64" y="413" font-size="23">Insufficient evidence.</text>
    <text x="64" y="440" font-size="17" fill="#585d68">How romantic.</text>
    <text x="259" y="482" text-anchor="middle" font-size="11" fill="#585d68" letter-spacing="1.4">SYNTHETIC DATA. EXPLICIT ASSUMPTIONS.</text>
  </g>
</svg>
