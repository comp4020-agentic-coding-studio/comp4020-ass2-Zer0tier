---
import { withBase } from 'astro-theme-university/url';
import CourseLayout from '../layouts/CourseLayout.astro';
import { courseMeta } from '../course-config';
import { sessionLabels } from '../site-config';

const materials = [
  { title: 'Lectures', href: '/lectures/', description: 'Weekly lecture notes, worked examples and the introductory slide deck.' },
  { title: sessionLabels.plural, href: '/sessions/', description: 'Practical labs, preparation and exercises for weeks 2–12.' },
  { title: 'Assignments', href: '/assessments/', description: 'Data report, midterm exam and profile-deployment project briefs.' },
  { title: 'Readings', href: '/readings/', description: 'Weekly sources and guidance on what to take from them.' },
  { title: 'Course toolkit', href: '/toolkit/', description: 'Synthetic datasets, executable models and the Null Island benchmark.' },
  { title: 'Timetable', href: '/weeks/', description: 'All twelve teaching weeks, tutorial dates and assessment deadlines.' },
];
---

<CourseLayout title={courseMeta.title} description={courseMeta.description} home>
  <div class="course-home">
    <header class="course-introduction">
      <h1>{courseMeta.title}</h1>
      <p>A computer science course exploring dating-profile systems through probability, experiment design and algorithmic modelling. Study platform rankings, profile photos and bios, messaging, first-date models and relationship maintenance.</p>
      <p>Across twelve weeks, use synthetic data and fictional cases to test assumptions and build a reproducible profile release. Assessment focuses on your engineering and evidence; no dating-app account or real-world dating experiment is required.</p>
    </header>

    <section aria-labelledby="learning-outcomes">
      <h2 id="learning-outcomes">Learning outcomes</h2>
      <p>At the completion of this course, you will be able to:</p>
      <ol class="outcomes">
        <li>Define a sampling frame and an experiment that separates a profile change from an exposure change.</li>
        <li>Implement ranking, mutual-selection, messaging and conversation-state models under explicit assumptions.</li>
        <li>Evaluate a frozen candidate with uncertainty, sensitivity tests and an exact simulation check.</li>
        <li>Deploy a reproducible fictional profile with a threat model, maintenance plan and a defensible evaluation against the synthetic Null Island benchmark.</li>
      </ol>
    </section>

    <section class="course-materials" aria-labelledby="course-materials">
      <h2 id="course-materials">Course materials</h2>
      <ul role="list">
        {materials.map(material => (
          <li>
            <a href={withBase(material.href)}>
              <strong>{material.title} <span aria-hidden="true">→</span></strong>
              <span class="material-description">{material.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</CourseLayout>

<style>
  .course-home {
    max-width: 58rem;
  }

  .course-introduction h1 {
    max-width: 28ch;
    margin: 0 0 1.5rem;
    color: var(--course-ink);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -.03em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .course-home p,
  .outcomes {
    max-width: var(--course-reading-width);
    margin-block: 0 1rem;
  }

  .course-home h2 {
    margin-block: 2.5rem 1rem;
  }

  .course-materials ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .course-materials li {
    margin: 0;
    border-top: 1px solid var(--course-line);
  }

  .course-materials a {
    display: block;
    height: 100%;
    padding: 1rem .5rem;
    text-decoration: none;
  }

  .course-materials a:hover,
  .course-materials a:focus-visible {
    background: var(--course-blue);
  }

  .course-materials strong {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-weight: 600;
  }

  .course-materials a:hover strong,
  .course-materials a:focus-visible strong {
    text-decoration: underline;
  }

  .material-description {
    display: block;
    margin-top: .35rem;
    color: var(--course-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 639px) {
    .course-materials ul {
      grid-template-columns: 1fr;
    }
  }
</style>
