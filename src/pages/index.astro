---
import { getPublishedCollection } from 'astro-course-university/content';
import { withBase } from 'astro-theme-university/url';
import CourseLayout from '../layouts/CourseLayout.astro';
import ConnectionArt from '../components/ConnectionArt.astro';
import { courseMeta } from '../course-config';
import { formatCourseDate } from '../lib/dates';
const assessments = (await getPublishedCollection('assessments')).sort((a,b) => a.data.week-b.data.week);
---
<CourseLayout title={courseMeta.title} description={courseMeta.description} home>
  <div class="home-content">
    <section class="home-hero" aria-labelledby="course-title">
      <div>
        <span class="eyebrow">School of Everyday Life · Slop University</span>
        <h1 id="course-title">How to Find<br /><em>a Partner</em><span aria-hidden="true">.</span></h1>
        <p class="intro">From a first hello to a mutual yes.</p>
        <p class="description">Meeting someone is one thing. Finding your way to each other is another. A practical course in dating, connection, and the conversations nobody put on your timetable.</p>
        <div class="hero-actions">
          <a class="button" href={withBase('/lectures/week-01/')}>Start with week 1 <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href={withBase('/weeks/')}>Explore the 12 weeks <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">No dating experience required. A little curiosity helps.</p>
      </div>
      <ConnectionArt />
    </section>

    <dl class="facts-strip">
      <div><dt>Your course</dt><dd>{courseMeta.code} · Undergraduate</dd></div>
      <div><dt>Teaching period</dt><dd>{courseMeta.session}, {courseMeta.year}</dd></div>
      <div><dt>The commitment</dt><dd>12 weeks · 5 hours a week</dd></div>
      <div><dt>What you leave with</dt><dd>Your own dating field guide</dd></div>
    </dl>

    <div class="home-columns">
      <section aria-labelledby="about-course">
        <span class="eyebrow">A course for the romantically curious</span>
        <h2 id="about-course">You can practise the awkward part.</h2>
        <p>You want to find a boyfriend, girlfriend, or partner. But where do you meet? What do you say? And how do you work out whether you both want the same thing?</p>
        <p>We take the early stages of dating seriously enough to teach them. Each week, work through a fictional case, try a conversation, and add one useful piece to a dating field guide. There is room for a yes, a no, and “I’m still figuring it out.”</p>
        <h3>By the end, you can…</h3>
        <ol class="outcomes">
          <li>Describe what you want, what you can offer, and the boundaries you bring.</li>
          <li>Choose a place to meet and start a conversation that has room for two people.</li>
          <li>Make a clear invitation, plan a first date, and respond thoughtfully to any answer.</li>
          <li>Discuss compatibility and decide together whether to become partners.</li>
        </ol>
      </section>
      <aside class="notice" aria-labelledby="room-title">
        <span class="eyebrow">Before your first hello</span>
        <h3 id="room-title">Your love life stays yours.</h3>
        <p>Practise with invented people. Work alone or role-play with a willing classmate. Your mark comes from your judgement and communication.</p>
        <p>Finding a partner is never homework.</p>
        <a href={withBase('/policies/')}>Read our classroom agreement <span aria-hidden="true">↗</span></a>
      </aside>
    </div>

    <div class="section-heading">
      <div><span class="eyebrow">The semester, in three chapters</span><h2>Small steps. Real possibilities.</h2></div>
      <a href={withBase('/weeks/')}>View the full syllabus <span aria-hidden="true">→</span></a>
    </div>
    <div class="phase-grid">
      <section class="phase-card"><span class="eyebrow">01 / Weeks 1–3</span><h3>Know yourself.</h3><p>Intentions, boundaries, and places you would actually enjoy being. Start with the life you have.</p><a href={withBase('/sessions/01-intentions/')}>Begin with intentions →</a></section>
      <section class="phase-card"><span class="eyebrow">02 / Weeks 4–7</span><h3>Make a connection.</h3><p>An honest introduction. A conversation that flows. A clear invitation and a first date with room to breathe.</p><a href={withBase('/sessions/04-introductions/')}>Find your opening →</a></section>
      <section class="phase-card"><span class="eyebrow">03 / Weeks 8–12</span><h3>Choose together.</h3><p>Uncertainty, compatibility, the small disagreements, and the conversation about what you both want next.</p><a href={withBase('/sessions/08-uncertainty/')}>Think about what follows →</a></section>
    </div>

    <div class="section-heading"><div><span class="eyebrow">Assessment</span><h2>A field guide, built as you go.</h2></div><a href={withBase('/assessments/')}>Read the briefs →</a></div>
    <div class="assessment-list">
      {assessments.map((assessment, index) => <a class="assessment-row" href={withBase(`/assessments/${assessment.id}/`)}>
        <span class="eyebrow">0{index + 1}</span><strong>{assessment.data.title}</strong><span class="due">Week {assessment.data.week} · {formatCourseDate(assessment.data.due)}</span><span class="weight">{assessment.data.weight}%</span>
      </a>)}
    </div>

    <div class="home-columns">
      <section><span class="eyebrow">How we learn</span><h2>Read it. Try it. Make it your own.</h2><p>Mondays: a one-hour lecture, 11 am–12 pm. Thursdays: a 90-minute workshop, 2–3.30 pm. Both meet in Conversation Room 2. Allow another 2½ hours for reading, drafting and assessments.</p><p>Teaching runs from {formatCourseDate(courseMeta.startDate)} to {formatCourseDate(courseMeta.endDate)}, with a break from 5–18 April. No prerequisites; no app account or current relationship needed.</p><a class="button secondary" href={withBase('/people/')}>Meet your teaching team →</a></section>
      <aside class="notice"><span class="eyebrow">Open your notebook</span><h3>One question to begin.</h3><p>If a relationship fits into your life, what does an ordinary Tuesday together look like?</p><a href={withBase('/decks/week-01/')}>Open the first lecture deck ↗</a></aside>
    </div>
    <p class="bottom-note">An imagined course at Slop University. Real questions, fictional classrooms, and no promises about your next meet-cute.</p>
  </div>
</CourseLayout>
