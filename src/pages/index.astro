---
import { withBase } from 'astro-theme-university/url';
import CourseLayout from '../layouts/CourseLayout.astro';
import { courseMeta } from '../course-config';
import { sessionLabels } from '../site-config';

const materials = [
  { title: 'Lectures', href: '/lectures/', description: 'Weekly lecture notes, worked examples and the introductory slide deck.' },
  { title: sessionLabels.plural, href: '/sessions/', description: 'Practical labs, preparation and exercises for weeks 2–12.' },
  { title: 'Assignments', href: '/assessments/', description: 'Data report, midterm exam and profile-deployment project briefs.' },
  { title: 'Readings', href: '/readings/', description: 'Weekly sources and guidance on what to take from them.' },
  { title: 'Course toolkit', href: '/toolkit/', description: 'Synthetic datasets, executable models and the Null Island benchmark.' },
  { title: 'Timetable', href: '/weeks/', description: 'All twelve teaching weeks, tutorial dates and assessment deadlines.' },
];
---

<CourseLayout title={courseMeta.title} description={courseMeta.description} home>
  <div class="course-home">
    <header class="course-introduction">
      <h1>{courseMeta.title}</h1>
      <p>A computer science course exploring dating-profile systems through probability, experiment design and algorithmic modelling. Study platform rankings, profile photos and bios, messaging, first-date models and relationship maintenance.</p>
      <p>Across twelve weeks, use synthetic data and fictional cases to test assumptions and build a reproducible profile release. Assessment focuses on your engineering and evidence; no dating-app account or real-world dating experiment is required.</p>
    </header>

    <section class="evidence-feature" aria-labelledby="evidence-feature-title">
      <p class="debugger-feature-label">TWO CONNECTED INVESTIGATIONS</p>
      <h2 id="evidence-feature-title">From a premature winner to release day</h2>
      <p>Alex’s dashboard picks a bio. Eight weeks later, the release still carries its unsupported claim. Follow the evidence through both decisions.</p>
      <div class="evidence-feature-links">
        <a href={withBase('/experiment-that-lied/')}><strong>The Experiment That Lied <span aria-hidden="true">→</span></strong><span>Week 4 · Open the spreadsheet, challenge the winner and save your evidence note.</span></a>
        <a href={withBase('/release-day/')}><strong>Release Day <span aria-hidden="true">→</span></strong><span>Week 12 · Carry your note forward, trace three faults and review the repaired release.</span></a>
      </div>
    </section>

    <section class="debugger-feature" aria-labelledby="debugger-feature-title">
      <p class="debugger-feature-label">INTERACTIVE MESSAGE LAB</p>
      <h2 id="debugger-feature-title">Romance Debugger</h2>
      <p>A read receipt arrives. A reply doesn’t. Choose Alex’s next action, then inspect the state and the evidence behind it. “We don’t know yet” is a valid result.</p>
      <a href={withBase('/romance-debugger/')}>Open the debugger <span aria-hidden="true">→</span></a>
    </section>

    <section aria-labelledby="learning-outcomes">
      <h2 id="learning-outcomes">Learning outcomes</h2>
      <p>At the completion of this course, you will be able to:</p>
      <ol class="outcomes">
        <li>Define a sampling frame and an experiment that separates a profile change from an exposure change.</li>
        <li>Implement ranking, mutual-selection, messaging and conversation-state models under explicit assumptions.</li>
        <li>Evaluate a frozen candidate with uncertainty, sensitivity tests and an exact simulation check.</li>
        <li>Deploy a reproducible fictional profile with a threat model, maintenance plan and a defensible evaluation against the synthetic Null Island benchmark.</li>
      </ol>
    </section>

    <section class="course-materials" aria-labelledby="course-materials">
      <h2 id="course-materials">Course materials</h2>
      <ul role="list">
        {materials.map(material => (
          <li>
            <a href={withBase(material.href)}>
              <strong>{material.title} <span aria-hidden="true">→</span></strong>
              <span class="material-description">{material.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</CourseLayout>

<style>
  .course-home {
    max-width: 58rem;
  }

  .course-introduction h1 {
    max-width: 28ch;
    margin: 0 0 1.5rem;
    color: var(--course-ink);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -.03em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .course-home p,
  .outcomes {
    max-width: var(--course-reading-width);
    margin-block: 0 1rem;
  }

  .course-home h2 {
    margin-block: 2.5rem 1rem;
  }

  .debugger-feature { margin-block: 2rem; padding: 1.5rem; border: 1px solid var(--course-line); border-radius: 12px; background: var(--course-blue); }
  .evidence-feature { margin-block: 2rem; padding: 1.5rem; border: 1px solid var(--course-line); border-radius: 12px; background: var(--course-pink); }
  .course-home .evidence-feature h2 { margin: .5rem 0 .75rem; }
  .evidence-feature-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .evidence-feature-links a { display: block; padding: 1rem; border: 1px solid var(--course-line); border-radius: 6px; background: var(--course-paper); color: var(--course-blue-ink); text-decoration: none; }
  .evidence-feature-links a:hover strong { text-decoration: underline; }
  .evidence-feature-links span { display: block; margin-top: .5rem; color: var(--course-ink); font-size: 1rem; }
  .evidence-feature-links strong span { display: inline; color: inherit; }
  .course-home .debugger-feature h2 { margin: .5rem 0 .75rem; }
  .course-home .debugger-feature-label { font-size: .8rem; color: var(--course-blue-ink); font-weight: 600; letter-spacing: .05em; }
  .debugger-feature a { display: inline-block; padding-block: .6rem; min-height: 44px; font-weight: 600; color: var(--course-blue-ink); }

  .course-materials ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .course-materials li {
    margin: 0;
    border-top: 1px solid var(--course-line);
  }

  .course-materials a {
    display: block;
    height: 100%;
    padding: 1rem .5rem;
    text-decoration: none;
  }

  .course-materials a:hover,
  .course-materials a:focus-visible {
    background: var(--course-blue);
  }

  .course-materials strong {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-weight: 600;
  }

  .course-materials a:hover strong,
  .course-materials a:focus-visible strong {
    text-decoration: underline;
  }

  .material-description {
    display: block;
    margin-top: .35rem;
    color: var(--course-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  @media (max-width: 639px) {
    .evidence-feature-links { grid-template-columns: 1fr; }
    .course-materials ul {
      grid-template-columns: 1fr;
    }
  }
</style>
