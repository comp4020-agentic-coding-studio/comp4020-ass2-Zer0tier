---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "../../layouts/CourseLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import WeekNavigation from "../../components/WeekNavigation.astro";
import TutorialQuiz from "../../components/TutorialQuiz.astro";
import { platformAuditQuiz } from "../../data/quizzes/platform-audit";
import { photoAuditQuiz } from "../../data/quizzes/photo-audit";
import { bioAuditQuiz } from "../../data/quizzes/bio-audit";
import { matchAuditQuiz } from "../../data/quizzes/match-audit";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p><strong>{formatCourseDate(session.data.date)}</strong></p>
  <Content />
  {session.id === '02-platforms' && <TutorialQuiz quiz={platformAuditQuiz} answersUrl="/data/quizzes/platform-audit.json" />}
  {session.id === '03-photo-assets' && <TutorialQuiz quiz={photoAuditQuiz} answersUrl="/data/quizzes/photo-audit.json" />}
  {session.id === '04-bio-experiment' && <TutorialQuiz quiz={bioAuditQuiz} answersUrl="/data/quizzes/bio-audit.json" />}
  {session.id === '05-match-probability' && <TutorialQuiz quiz={matchAuditQuiz} answersUrl="/data/quizzes/match-audit.json" />}
  <SpecList spec={session.data.spec}>
    Before you finish, check your engineering artefact against these requirements.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
  <WeekNavigation week={session.data.week} collection="sessions" />
</ContentLayout>
