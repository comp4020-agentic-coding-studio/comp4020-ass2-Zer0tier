---
import ContentLayout from "../../layouts/CourseLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    Thursdays, 2–3.30 pm, Conversation Room 2. Bring the work named on each page;
    leave with one more piece of your dating field guide. Every role-play has a
    solo written alternative. Teaching pauses from 5–18 April.
  </p>
  <SessionsGrid />
</ContentLayout>
